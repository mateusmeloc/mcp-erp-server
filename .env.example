# Demo values only. Copy to .env and load it in a POSIX shell:  set -a; . ./.env; set +a
# (The JSON in ERP_USERS stays in single quotes so the shell does not mangle it.)
# NEVER reuse these anywhere real: with NODE_ENV=production the server refuses to start
# if any credential contains "change-me".

# At least 32 characters. Signs OAuth tokens and confirmation tokens.
TOKEN_SECRET=change-me-demo-secret-0123456789abcdef0123456789

# One entry per person, one token each (at least 24 characters). Roles: admin, manager, frontdesk, agent.
ERP_USERS='[{"name":"demo-admin","role":"admin","token":"change-me-demo-admin-token-0001"},{"name":"demo-reception","role":"frontdesk","token":"change-me-demo-frontdesk-token-0002"},{"name":"demo-bot","role":"agent","token":"change-me-demo-agent-token-0003"}]'

PORT=3000
# Public base URL used in the OAuth metadata (set it when deployed behind HTTPS).
# PUBLIC_URL=https://erp-mcp.example.com
# Global kill switch for every write tool.
ALLOW_WRITES=true
# Set to 1 behind a reverse proxy so rate limits see the real client IP.
TRUST_PROXY=0
WRITES_PER_MINUTE=10
CONFIRM_TTL_SECONDS=300
ACCESS_TTL_SECONDS=3600
REFRESH_TTL_SECONDS=2592000
